---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page introuvable (404) | Expert Réno & Expert Travaux';
const description = 'La page demandée n’existe pas ou a été déplacée.';
---

<BaseLayout title={title} description={description}>
  <section class="bg-white">
    <div class="mx-auto flex max-w-content flex-col items-center px-5 py-28 text-center">
      <p class="font-serif text-6xl font-bold text-ocre-dark">404</p>
      <h1 class="mt-4 font-serif text-3xl font-bold text-foret">Cette page est introuvable</h1>
      <p class="mt-3 max-w-md text-ardoise">La page que vous cherchez n’existe pas ou a été déplacée.</p>
      <a href="/" class="mt-8 inline-flex items-center justify-center rounded-full bg-foret px-7 py-3.5 font-semibold text-white transition-colors hover:bg-foret-light">
        Retour à l’accueil
      </a>
    </div>
  </section>
</BaseLayout>
