---
// ════════════════════════════════════════════════════════════════════
//  ESPACE CLIENT — Expert Réno (page privée, non indexée)
//
//  • Connexion client (Supabase Auth)
//  • Suivi de projet : avancement + étapes
//  • Documents : téléchargement (devis, plans…) ET dépôt par le client
//
//  Sécurité : chaque client ne voit que SES projets/documents (RLS).
//  Voir supabase/schema-espace-client.sql.
// ════════════════════════════════════════════════════════════════════
---

<!doctype html>
<html lang="fr" class="bg-brume">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Espace client — Expert Réno</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen font-sans text-encre">
    <!-- Barre supérieure -->
    <header class="border-b border-brume bg-white">
      <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5">
        <a href="/" class="flex items-center gap-3">
          <svg viewBox="0 0 64 64" class="h-9 w-9" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#1A1815"></rect>
            <circle cx="32" cy="32" r="23" fill="none" stroke="#B4894E" stroke-width="4.5" stroke-linecap="round" stroke-dasharray="116 30" transform="rotate(125 32 32)"></circle>
            <text x="17" y="42" font-family="Georgia, serif" font-size="28" font-weight="700" fill="#B4894E">E</text>
            <text x="31" y="44" font-family="Georgia, serif" font-size="30" font-weight="700" fill="#F7F4EF">R</text>
          </svg>
          <div class="leading-tight">
            <p class="font-serif text-lg font-bold text-foret">Expert Réno</p>
            <p class="text-xs text-ardoise">Espace client</p>
          </div>
        </a>
        <button id="logout" hidden class="rounded-full border border-foret/30 px-4 py-1.5 text-sm font-semibold text-foret transition-colors hover:bg-foret/5">Se déconnecter</button>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-5 py-8">
      <div id="config-missing" hidden class="rounded-2xl border border-amber-300 bg-amber-50 p-6 text-amber-900">
        <p class="font-semibold">Espace client non configuré</p>
        <p class="mt-1 text-sm">Renseignez <code>PUBLIC_SUPABASE_URL</code> et <code>PUBLIC_SUPABASE_ANON_KEY</code>, puis exécutez <code>supabase/schema-espace-client.sql</code>.</p>
      </div>

      <!-- Connexion -->
      <section id="login" hidden class="mx-auto max-w-sm rounded-2xl border border-brume bg-white p-8 shadow-card">
        <h1 class="font-serif text-2xl font-bold text-foret">Bienvenue</h1>
        <p class="mt-1 text-sm text-ardoise">Connectez-vous pour suivre votre projet et accéder à vos documents.</p>
        <form id="login-form" class="mt-6 space-y-4">
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium">Email</label>
            <input id="email" type="email" required autocomplete="username" class="w-full rounded-lg border border-brume px-4 py-3 outline-none focus:border-foret focus:ring-2 focus:ring-foret/20" />
          </div>
          <div>
            <label for="password" class="mb-1.5 block text-sm font-medium">Mot de passe</label>
            <input id="password" type="password" required autocomplete="current-password" class="w-full rounded-lg border border-brume px-4 py-3 outline-none focus:border-foret focus:ring-2 focus:ring-foret/20" />
          </div>
          <button type="submit" class="w-full rounded-full bg-foret px-7 py-3 font-semibold text-white transition-colors hover:bg-foret-light disabled:opacity-60">Se connecter</button>
          <p id="login-error" role="alert" class="text-sm text-red-600"></p>
          <p class="text-center text-xs text-ardoise">Pas encore d'accès ? Contactez Expert Réno pour recevoir vos identifiants.</p>
        </form>
      </section>

      <!-- Tableau de bord projet -->
      <section id="app" hidden>
        <div id="empty" hidden class="rounded-2xl border border-brume bg-white p-10 text-center text-ardoise">
          Aucun projet pour le moment. Votre interlocuteur Expert Réno créera votre dossier prochainement.
        </div>

        <!-- Sélecteur de projet (si plusieurs) -->
        <div id="projet-switch" hidden class="mb-5"></div>

        <div id="projet" hidden>
          <!-- En-tête projet -->
          <div class="rounded-2xl border border-brume bg-white p-6 shadow-card sm:p-8">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p id="p-type" class="text-sm font-semibold uppercase tracking-widest text-ocre-dark"></p>
                <h1 id="p-titre" class="mt-1 font-serif text-2xl font-bold text-foret sm:text-3xl"></h1>
                <p id="p-adresse" class="mt-1 text-sm text-ardoise"></p>
              </div>
              <span id="p-statut" class="rounded-full px-3 py-1 text-sm font-semibold"></span>
            </div>
            <!-- Barre d'avancement -->
            <div class="mt-6">
              <div class="mb-1.5 flex items-center justify-between text-sm">
                <span class="font-medium text-encre">Avancement</span>
                <span id="p-avancement-txt" class="font-semibold text-foret"></span>
              </div>
              <div class="h-3 w-full overflow-hidden rounded-full bg-brume">
                <div id="p-avancement-bar" class="h-full rounded-full bg-foret transition-all" style="width:0%"></div>
              </div>
            </div>
          </div>

          <div class="mt-6 grid gap-6 lg:grid-cols-2">
            <!-- Étapes -->
            <div class="rounded-2xl border border-brume bg-white p-6 shadow-card">
              <h2 class="font-serif text-lg font-bold text-foret">Étapes du projet</h2>
              <ol id="etapes" class="mt-5 space-y-4"></ol>
            </div>

            <!-- Documents -->
            <div class="rounded-2xl border border-brume bg-white p-6 shadow-card">
              <div class="flex items-center justify-between">
                <h2 class="font-serif text-lg font-bold text-foret">Documents</h2>
                <label class="cursor-pointer rounded-full bg-foret px-4 py-1.5 text-sm font-semibold text-white hover:bg-foret-light">
                  + Déposer
                  <input id="upload" type="file" class="hidden" />
                </label>
              </div>
              <p id="upload-status" class="mt-2 text-sm"></p>
              <ul id="documents" class="mt-4 space-y-2"></ul>
              <p id="documents-empty" hidden class="mt-4 text-sm text-ardoise">Aucun document pour l'instant.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      import { createClient } from '@supabase/supabase-js';

      const URL = import.meta.env.PUBLIC_SUPABASE_URL;
      const KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

      const STATUTS = {
        prepa: { label: 'Préparation', cls: 'bg-blue-100 text-blue-800' },
        en_cours: { label: 'Travaux en cours', cls: 'bg-amber-100 text-amber-800' },
        en_pause: { label: 'En pause', cls: 'bg-gray-100 text-gray-700' },
        termine: { label: 'Terminé', cls: 'bg-green-100 text-green-800' },
      };
      const TYPE_ICON = { devis: '📄', plan: '📐', photo: '🖼️', assurance: '🛡️', autre: '📎' };

      const $ = (id) => document.getElementById(id);
      const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const fmtDate = (iso) => iso ? new Date(iso).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) : '';
      const fmtTaille = (o) => o > 1048576 ? (o / 1048576).toFixed(1) + ' Mo' : Math.max(1, Math.round(o / 1024)) + ' Ko';

      let projets = [];
      let courant = null;
      let supabase = null;

      if (!URL || !KEY) {
        $('config-missing').hidden = false;
      } else {
        supabase = createClient(URL, KEY);
        init();
      }

      async function init() {
        const { data: { session } } = await supabase.auth.getSession();
        session ? showApp() : showLogin();

        $('login-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          $('login-error').textContent = '';
          const btn = e.target.querySelector('button');
          btn.disabled = true;
          const { error } = await supabase.auth.signInWithPassword({ email: $('email').value.trim(), password: $('password').value });
          btn.disabled = false;
          if (error) $('login-error').textContent = 'Email ou mot de passe incorrect.';
          else showApp();
        });

        $('logout').addEventListener('click', async () => { await supabase.auth.signOut(); location.reload(); });
        $('upload').addEventListener('change', uploadDoc);
      }

      function showLogin() { $('login').hidden = false; $('app').hidden = true; $('logout').hidden = true; }

      async function showApp() {
        $('login').hidden = true; $('app').hidden = false; $('logout').hidden = false;
        await loadProjets();
      }

      async function loadProjets() {
        const { data, error } = await supabase
          .from('projets')
          .select('*, projet_etapes(*), documents(*)')
          .order('created_at', { ascending: false });
        if (error) { console.error(error); $('empty').hidden = false; return; }
        projets = data || [];
        if (projets.length === 0) { $('empty').hidden = false; $('projet').hidden = true; return; }
        $('empty').hidden = true;
        courant = projets[0];
        renderSwitch();
        renderProjet();
      }

      function renderSwitch() {
        if (projets.length < 2) { $('projet-switch').hidden = true; return; }
        $('projet-switch').hidden = false;
        $('projet-switch').innerHTML = projets.map((p) =>
          `<button data-p="${p.id}" class="psw mr-2 mb-2 rounded-full px-4 py-1.5 text-sm font-medium">${esc(p.titre || 'Projet')}</button>`
        ).join('');
        $('projet-switch').querySelectorAll('.psw').forEach((b) => {
          const actif = b.getAttribute('data-p') === courant.id;
          b.className = 'psw mr-2 mb-2 rounded-full px-4 py-1.5 text-sm font-medium ' + (actif ? 'bg-foret text-white' : 'bg-white border border-brume text-ardoise hover:text-foret');
          b.addEventListener('click', () => { courant = projets.find((x) => x.id === b.getAttribute('data-p')); renderSwitch(); renderProjet(); });
        });
      }

      function renderProjet() {
        $('projet').hidden = false;
        const s = STATUTS[courant.statut] || { label: courant.statut, cls: 'bg-gray-100 text-gray-700' };
        $('p-type').textContent = courant.type || 'Projet de rénovation';
        $('p-titre').textContent = courant.titre || 'Mon projet';
        $('p-adresse').textContent = courant.adresse || '';
        $('p-statut').textContent = s.label;
        $('p-statut').className = 'rounded-full px-3 py-1 text-sm font-semibold ' + s.cls;
        const pct = Math.max(0, Math.min(100, courant.avancement || 0));
        $('p-avancement-txt').textContent = pct + '%';
        $('p-avancement-bar').style.width = pct + '%';

        // Étapes
        const etapes = (courant.projet_etapes || []).slice().sort((a, b) => a.ordre - b.ordre);
        $('etapes').innerHTML = etapes.length === 0
          ? '<li class="text-sm text-ardoise">Les étapes seront ajoutées prochainement.</li>'
          : etapes.map((e) => {
              const m = e.etat === 'termine' ? { dot: 'bg-foret text-white', mark: '✓', txt: 'text-encre' }
                      : e.etat === 'en_cours' ? { dot: 'bg-ocre text-white animate-pulse', mark: '•', txt: 'text-encre font-semibold' }
                      : { dot: 'bg-brume text-ardoise', mark: '', txt: 'text-ardoise' };
              return `<li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs ${m.dot}">${m.mark}</span>
                <span class="${m.txt}">${esc(e.libelle)}${e.date_prevue ? `<span class="block text-xs text-ardoise">${fmtDate(e.date_prevue)}</span>` : ''}</span>
              </li>`;
            }).join('');

        // Documents
        const docs = (courant.documents || []).slice().sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
        $('documents-empty').hidden = docs.length > 0;
        $('documents').innerHTML = docs.map((d) =>
          `<li class="flex items-center justify-between gap-3 rounded-lg border border-brume px-3 py-2.5">
            <span class="flex min-w-0 items-center gap-2">
              <span>${TYPE_ICON[d.type] || '📎'}</span>
              <span class="min-w-0">
                <span class="block truncate text-sm font-medium text-encre">${esc(d.nom)}</span>
                <span class="block text-xs text-ardoise">${fmtDate(d.created_at)} · ${fmtTaille(d.taille)} · ${d.depose_par === 'client' ? 'déposé par vous' : 'Expert Réno'}</span>
              </span>
            </span>
            <button data-dl="${esc(d.chemin)}" class="shrink-0 rounded-full border border-foret/30 px-3 py-1 text-xs font-semibold text-foret hover:bg-foret/5">Télécharger</button>
          </li>`
        ).join('');
        $('documents').querySelectorAll('button[data-dl]').forEach((b) => {
          b.addEventListener('click', () => download(b.getAttribute('data-dl')));
        });
      }

      async function download(chemin) {
        const { data, error } = await supabase.storage.from('documents').createSignedUrl(chemin, 60);
        if (error || !data) { alert('Téléchargement indisponible.'); return; }
        window.open(data.signedUrl, '_blank');
      }

      async function uploadDoc(e) {
        const file = e.target.files[0];
        if (!file || !courant) return;
        $('upload-status').className = 'mt-2 text-sm text-ardoise';
        $('upload-status').textContent = 'Envoi en cours…';
        const chemin = `${courant.id}/${Date.now()}-${file.name.replace(/[^\w.\-]/g, '_')}`;
        const up = await supabase.storage.from('documents').upload(chemin, file);
        if (up.error) { $('upload-status').className = 'mt-2 text-sm text-red-600'; $('upload-status').textContent = "Échec de l'envoi."; return; }
        const ins = await supabase.from('documents').insert({
          projet_id: courant.id, nom: file.name, chemin, type: 'autre', taille: file.size, depose_par: 'client',
        });
        if (ins.error) { $('upload-status').className = 'mt-2 text-sm text-red-600'; $('upload-status').textContent = "Document envoyé mais non enregistré."; return; }
        $('upload-status').className = 'mt-2 text-sm text-green-700';
        $('upload-status').textContent = 'Document déposé ✓';
        e.target.value = '';
        await loadProjets();
      }
    </script>
  </body>
</html>
