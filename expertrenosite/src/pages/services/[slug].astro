---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BookingButton from '../../components/BookingButton.astro';
import { marques } from '../../data/site';
import { getCollection } from 'astro:content';

// Génère automatiquement une page par fichier Markdown du dossier services/.
export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await service.render();
const data = service.data;
const nomMarque = marques[data.marque].nom;
---

<BaseLayout title={data.metaTitle} description={data.metaDescription}>
  <PageHeader surtitre={nomMarque} titre={data.titre} sousTitre={data.resume} />

  <section class="bg-white">
    <div class="mx-auto grid max-w-content gap-12 px-5 py-16 lg:grid-cols-3">
      <!-- Contenu Markdown du service -->
      <article class="prose-style lg:col-span-2">
        <Content />
      </article>

      <!-- Encadré : points-clés + CTA -->
      <aside class="lg:col-span-1">
        <div class="sticky top-28 space-y-6">
          {
            data.points.length > 0 && (
              <div class="rounded-2xl border border-brume bg-sable p-6">
                <h2 class="font-serif text-lg font-bold text-foret">Ce que ça comprend</h2>
                <ul class="mt-4 space-y-3">
                  {data.points.map((point) => (
                    <li class="flex gap-3 text-sm text-encre">
                      <span class="mt-1 text-ocre-dark">✓</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <div class="rounded-2xl border border-brume bg-sable p-6 text-center">
            <p class="font-serif text-lg font-bold text-foret">Intéressé ?</p>
            <p class="mt-2 text-sm text-ardoise">Échangeons sur votre projet.</p>
            <div class="mt-4 flex flex-col gap-3">
              <BookingButton label="Réserver un créneau" />
              <a href="/contact" class="text-sm font-semibold text-ocre-dark hover:underline">Ou nous écrire →</a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* Styles du contenu Markdown des services (titres, listes, paragraphes) */
  .prose-style :global(h2) {
    font-family: 'Fraunces', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #17150F;
    margin: 1.75rem 0 0.75rem;
  }
  .prose-style :global(h3) {
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #17150F;
    margin: 1.25rem 0 0.5rem;
  }
  .prose-style :global(p) {
    color: #6E685E;
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose-style :global(ul),
  .prose-style :global(ol) {
    color: #6E685E;
    margin: 0 0 1rem 1.25rem;
    line-height: 1.75;
  }
  .prose-style :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose-style :global(ul) {
    list-style: disc;
  }
  .prose-style :global(ol) {
    list-style: decimal;
  }
  .prose-style :global(strong) {
    color: #17150F;
  }
</style>
