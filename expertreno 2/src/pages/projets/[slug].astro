---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Gallery from '../../components/Gallery.astro';
import BookingButton from '../../components/BookingButton.astro';
import { getCollection } from 'astro:content';

// Génère automatiquement une page par fichier Markdown du dossier projets/.
export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.slug },
    props: { projet },
  }));
}

const { projet } = Astro.props;
const { Content } = await projet.render();
const data = projet.data;

const title = `${data.titre} — Réalisation | Expert Réno & Expert Travaux`;
const description = `${data.resume} Budget : ${data.budget}${data.ameublement ? ' + ' + data.ameublement : ''}, ${data.delaiTravaux}.`;
---

<BaseLayout title={title} description={description}>
  <PageHeader surtitre="Réalisation" titre={data.titre} sousTitre={data.resume} />

  <section class="bg-white">
    <div class="mx-auto max-w-content px-5 py-16">
      <!-- Chiffres-clés du projet -->
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-brume bg-sable p-6">
          <p class="text-xs uppercase tracking-wide text-ardoise">Budget travaux</p>
          <p class="mt-1 font-serif text-2xl font-bold text-foret">{data.budget}</p>
          {data.ameublement && <p class="mt-1 text-sm text-ardoise">+ {data.ameublement}</p>}
        </div>
        <div class="rounded-2xl border border-brume bg-sable p-6">
          <p class="text-xs uppercase tracking-wide text-ardoise">Délai de réalisation</p>
          <p class="mt-1 font-serif text-2xl font-bold text-foret">{data.delaiTravaux}</p>
        </div>
        {
          data.delaiPrepa && (
            <div class="rounded-2xl border border-brume bg-sable p-6">
              <p class="text-xs uppercase tracking-wide text-ardoise">Préparation</p>
              <p class="mt-1 font-serif text-2xl font-bold text-foret">{data.delaiPrepa}</p>
            </div>
          )
        }
      </div>

      <div class="mt-12 grid gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <!-- Description (Markdown) -->
          <article class="text-ardoise leading-relaxed">
            <Content />
          </article>
        </div>
        <aside>
          <div class="rounded-2xl border border-brume bg-white p-6">
            <h2 class="font-serif text-lg font-bold text-foret">Travaux réalisés</h2>
            <ul class="mt-4 space-y-3">
              {
                data.travaux.map((t) => (
                  <li class="flex gap-3 text-sm text-encre">
                    <span class="mt-1 text-ocre-dark">✓</span>
                    <span>{t}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>

      <!-- Galerie photo -->
      <div class="mt-12">
        <h2 class="mb-6 font-serif text-2xl font-bold text-foret">Galerie</h2>
        <Gallery images={data.galerie} />
      </div>
    </div>
  </section>

  <section class="border-t border-brume bg-sable">
    <div class="mx-auto max-w-content px-5 py-14 text-center">
      <h2 class="font-serif text-2xl font-bold text-foret sm:text-3xl">Un projet similaire ?</h2>
      <p class="mx-auto mt-3 max-w-xl text-ardoise">Parlons budget, délais et faisabilité.</p>
      <div class="mt-7 flex justify-center"><BookingButton label="Réserver un créneau" /></div>
    </div>
  </section>
</BaseLayout>
