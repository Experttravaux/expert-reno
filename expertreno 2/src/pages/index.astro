---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import KeyFigures from '../components/KeyFigures.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BookingButton from '../components/BookingButton.astro';
import { marques, engagements } from '../data/site';
import { getCollection } from 'astro:content';

// Récupération des services et projets pour les aperçus de la page d'accueil.
const services = (await getCollection('services')).sort((a, b) => a.data.ordre - b.data.ordre);
const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre).slice(0, 3);

// SEO de la page d'accueil
const title = 'Expert Réno & Expert Travaux | Entreprise générale & rénovation à Toulouse';
const description =
  'Entreprise générale de bâtiment tous corps d’état et assistance à maîtrise d’ouvrage à Toulouse, Bordeaux et partout en France. 25 ans d’expérience, budget et délais maîtrisés.';
---

<BaseLayout title={title} description={description}>
  <Hero />

  <!-- DEUX EXPERTISES, UN SEUL INTERLOCUTEUR -->
  <section class="bg-white">
    <div class="mx-auto max-w-content px-5 py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-ocre-dark">Deux expertises complémentaires</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-foret sm:text-4xl">Le conseil et la réalisation, sous le même toit</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-brume bg-white p-8 shadow-card">
          <p class="font-serif text-2xl font-bold text-foret">{marques.reno.nom}</p>
          <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-ardoise">{marques.reno.role}</p>
          <p class="mt-4 text-ardoise">{marques.reno.accroche}</p>
        </div>
        <div class="rounded-2xl border border-ocre/30 bg-sable p-8 shadow-card">
          <p class="font-serif text-2xl font-bold text-ocre-dark">{marques.travaux.nom}</p>
          <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-ardoise">{marques.travaux.role}</p>
          <p class="mt-4 text-ardoise">{marques.travaux.accroche}</p>
        </div>
      </div>
    </div>
  </section>

  <KeyFigures />

  <!-- APERÇU DES SERVICES -->
  <section class="bg-white">
    <div class="mx-auto max-w-content px-5 py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-ocre-dark">Nos services</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-foret sm:text-4xl">Tout ce dont votre projet a besoin</h2>
        </div>
        <a href="/services" class="text-sm font-semibold text-ocre-dark hover:underline">Voir tous les services →</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <ServiceCard
              titre={s.data.titre}
              resume={s.data.resume}
              marque={s.data.marque}
              vedette={s.data.vedette}
              lien={`/services/${s.slug}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- DEUX PUBLICS : PARTICULIERS / PROFESSIONNELS -->
  <section class="bg-brume">
    <div class="mx-auto max-w-content px-5 py-16 sm:py-20">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl bg-white p-8 shadow-card">
          <h3 class="font-serif text-2xl font-bold text-foret">Vous êtes un particulier</h3>
          <p class="mt-3 text-ardoise">
            Rénovation de votre logement, optimisation du budget, obtention des aides
            (MaPrimeRénov’, éco-PTZ…) : on vous accompagne du premier plan à la remise des clés.
          </p>
          <a href="/services" class="mt-5 inline-flex font-semibold text-ocre-dark hover:underline">Découvrir nos services →</a>
        </div>
        <div class="rounded-2xl border border-foret/15 bg-foret/5 p-8 shadow-card">
          <h3 class="font-serif text-2xl font-bold text-foret">Vous êtes un professionnel</h3>
          <p class="mt-3 text-ardoise">
            Assurances et syndics : un interlocuteur unique pour vos sinistres et vos travaux
            de copropriété, avec des devis conformes et des délais tenus.
          </p>
          <a href="/professionnels" class="mt-5 inline-flex font-semibold text-ocre-dark hover:underline">Espace professionnels →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ENGAGEMENTS / RÉASSURANCE -->
  <section class="bg-white">
    <div class="mx-auto max-w-content px-5 py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-ocre-dark">Pourquoi nous faire confiance</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-foret sm:text-4xl">Des engagements concrets</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          engagements.map((e) => (
            <div class="rounded-2xl border border-brume bg-white p-6">
              <h3 class="font-serif text-lg font-bold text-foret">{e.titre}</h3>
              <p class="mt-2 text-sm text-ardoise">{e.texte}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- APERÇU DES PROJETS -->
  <section class="bg-sable">
    <div class="mx-auto max-w-content px-5 py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-ocre-dark">Nos réalisations</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-foret sm:text-4xl">Des projets concrets, chiffrés</h2>
        </div>
        <a href="/projets" class="text-sm font-semibold text-ocre-dark hover:underline">Voir tous les projets →</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          projets.map((p) => (
            <ProjectCard
              titre={p.data.titre}
              resume={p.data.resume}
              budget={p.data.budget}
              ameublement={p.data.ameublement}
              delaiTravaux={p.data.delaiTravaux}
              couverture={p.data.couverture}
              lien={`/projets/${p.slug}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- APPEL À L'ACTION FINAL -->
  <section class="border-t border-brume bg-sable">
    <div class="mx-auto max-w-content px-5 py-16 text-center sm:py-20">
      <h2 class="font-serif text-3xl font-bold text-foret sm:text-4xl">Parlons de votre projet</h2>
      <p class="mx-auto mt-4 max-w-xl text-ardoise">
        Un échange gratuit pour faire le point et vous dire, en toute transparence, comment sécuriser votre rénovation.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <BookingButton label="Réserver un créneau" />
        <a href="/contact" class="inline-flex items-center justify-center rounded-full border border-foret/30 px-7 py-3.5 font-semibold text-foret transition-colors hover:bg-foret/5">
          Nous écrire
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
