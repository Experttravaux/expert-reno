      <p class="note" id="paynote"></p>
    </div>
    <div class="card" id="capture" style="display:none">
      <div class="lbl" id="cap-title">Recevez votre devis par email</div>
      <input class="f" id="cap-prenom" placeholder="Prénom *">
      <input class="f" id="cap-nom" placeholder="Nom">
      <input class="f" id="cap-tel" type="tel" placeholder="Téléphone *">
      <input class="f" id="cap-email" type="email" placeholder="Email *">
      <label style="display:flex;align-items:flex-start;gap:9px;font-size:14px;line-height:1.3;margin:2px 0 12px;cursor:pointer;color:#17150F"><input type="checkbox" id="cap-rappel" style="width:18px;height:18px;margin-top:1px;flex:0 0 auto"> Je souhaite être recontacté(e) sous 24 h par un expert.</label>
      <button class="btn" id="cap-send">Envoyer →</button>
      <p class="note" id="cap-done" style="text-align:left"></p>
    </div>
  </div>

  <!-- generic -->
  <div class="screen" id="sg">
    <h1 id="g-title">Votre projet</h1>
    <p class="sub" id="g-sub"></p>
    <div class="card" id="g-neufreno"><div class="lbl">Neuf ou rénovation ?</div><div class="seg nr"><button>🔧 Rénovation</button><button>🏗️ Neuf</button></div></div>
    <div class="card"><div class="lbl">Parlez-nous de votre projet</div>
      <textarea class="f" rows="3" placeholder="Décrivez vos travaux…"></textarea>
      <label class="drop" style="margin-bottom:10px">📎 Déposez votre plan / photos<small>facultatif</small><input type="file" hidden multiple></label>
      <input class="f" placeholder="Prénom *"><input class="f" type="tel" placeholder="Téléphone *"><input class="f" type="email" placeholder="Email *">
      <button class="btn" id="g-send">Envoyer ma demande →</button>
      <p class="note" id="g-done"></p>
    </div>
  </div>
</main>

<script>
  import { createClient } from '@supabase/supabase-js';
  const SB_URL=import.meta.env.PUBLIC_SUPABASE_URL, SB_KEY=import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase=(SB_URL&&SB_KEY)?createClient(SB_URL,SB_KEY):null;
  let lastDevis=null, capIntent='';
  const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
  const euro=n=>n.toLocaleString('fr-FR',{minimumFractionDigits:2,maximumFractionDigits:2})+' €';
  const V=id=>+(document.getElementById(id)?.value)||0, CK=id=>!!document.getElementById(id)?.checked;
  let hist=['s0'], gamme='essentiel', soltype='aucun', nature='reno', travauxBut='travaux';
  const GAMME={essentiel:1, confort:1.4, premium:2};
  function show(id){ $$('.screen').forEach(s=>s.classList.remove('on')); $('#'+id).classList.add('on'); $('#back').style.display=id==='s0'?'none':'block'; window.scrollTo({top:0,behavior:'smooth'}); }
  function go(id){ hist.push(id); show(id); }
  $('#back').addEventListener('click',()=>{ hist.pop(); show(hist[hist.length-1]||'s0'); });

  document.addEventListener('click',e=>{
    const swx=e.target.closest('.sw'); if(swx){ const cb=swx.querySelector('input[type=checkbox]'); if(cb && e.target!==cb) cb.checked=!cb.checked; return; }
    const p=e.target.closest('.pick'); if(p){ const g=p.dataset.go;
      if(g==='sinistre') go('s1'); else if(g==='eau') go('s2'); else if(g==='feu') go('s2e'); else if(g==='tempete') go('s2t');
      else if(g==='pret'){ travauxBut='prêt travaux'; openTravaux('Devis pour un prêt travaux','Détaillé et crédible pour votre banque — cochez les lots.'); }
      else if(g==='estim'){ travauxBut='estimation'; openTravaux('Estimation de votre projet','Cochez les lots concernés, on vous chiffre tout.'); }
      else if(g==='travaux'){ travauxBut='réalisation'; openTravaux('Faire réaliser vos travaux','Cochez les lots, le devis se calcule tout seul.'); }
      return; }
    const gb=e.target.closest('.gamme button'); if(gb){ gb.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('on')); gb.classList.add('on'); gamme=gb.dataset.g; return; }
    const st=e.target.closest('.soltype button'); if(st){ st.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('on')); st.classList.add('on'); soltype=st.dataset.s; return; }
    const nt=e.target.closest('.nature button'); if(nt){ nt.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('on')); nt.classList.add('on'); nature=nt.dataset.n; return; }
    const sb=e.target.closest('.nr button'); if(sb){ sb.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('on')); sb.classList.add('on'); }
  });
  function openGeneric(t,s,n){ $('#g-title').textContent=t; $('#g-sub').textContent=s; $('#g-neufreno').style.display=n?'block':'none'; $('#g-done').textContent=''; go('sg'); }
  $('#g-send').addEventListener('click',()=>{ $('#g-done').textContent='✅ Merci ! (prototype) — la demande part dans ton CRM + email.'; });
  $('#voice')?.addEventListener('click',()=>{ $('#voicenote').textContent='🎙️ (Démo) → enregistrement → transcription → l\'IA pré-remplit le devis. Limité à ~2 min / quota de tokens pour maîtriser le coût.'; });

  // rendu partagé du devis
  function renderDevis(rows, dossier){
    // évacuation déchets 1%
    let htW=rows.filter(r=>!r.grp).reduce((a,r)=>a+r.tot,0);
    rows.push({grp:'Évacuation'}); rows.push({d:'Évacuation et traitement des déchets (1 %)',q:1,u:'F',pu:+(htW*0.01).toFixed(2),tva:0.1,tot:+(htW*0.01).toFixed(2)});
    const F=[]; for(let i=0;i<rows.length;i++){ const r=rows[i]; if(r.grp){ if(rows[i+1]&&!rows[i+1].grp) F.push(r); } else F.push(r); }
    const tb=$('#rows'); tb.innerHTML=''; let ht=0,tva=0;
    F.forEach(r=>{ if(r.grp) tb.insertAdjacentHTML('beforeend',`<tr class="grp"><td colspan="5">${r.grp}</td></tr>`);
      else{ ht+=r.tot; tva+=r.tot*(r.tva||0.1); tb.insertAdjacentHTML('beforeend',`<tr><td>${r.d}</td><td class="r">${(''+r.q).replace('.',',')}</td><td>${r.u}</td><td class="r">${euro(r.pu)}</td><td class="r">${euro(r.tot)}</td></tr>`);} });
    tva=+tva.toFixed(2);
    $('#t_ht').textContent=euro(ht); $('#t_tva').textContent=euro(tva); $('#t_ttc').textContent=euro(ht+tva);
    $('#dossierTxt').textContent='DOSSIER : '+dossier;
    const _num=new Date().toISOString().slice(0,10).replace(/-/g,''), _date=new Date().toLocaleDateString('fr-FR');
    $('#dnum').textContent=_num; $('#ddate').textContent=_date;
    const resume=F.filter(r=>!r.grp).map(r=>`- ${r.d} : ${(''+r.q).replace('.',',')} ${r.u} x ${euro(r.pu)} = ${euro(r.tot)}`).join('\n');
    lastDevis={ dossier, ht:+ht.toFixed(2), tva:+tva.toFixed(2), ttc:+(ht+tva).toFixed(2), resume, rows:F, num:_num, date:_date };
    const cap=$('#capture'); if(cap) cap.style.display='none';
    go('s3');
  }
  function mk(){ const rows=[]; return { rows, G:t=>rows.push({grp:t}), L:(d,q,u,pu,tva=0.1)=>{ if(q>0) rows.push({d,q:+(+q).toFixed(2),u,pu:+(+pu).toFixed(2),tva,tot:+(q*pu).toFixed(2)}); } }; }

  // ===== DÉGÂT DES EAUX =====
  const Peau={ dm_faience:15,dm_placo:15,depose_cuisine:800,depose_parquet:12,depose_cabine:220,
    placo:63,doublage:63,enduit:220,toile:18,peint:22.5,faience:90,
    parquet:55,carrelage_sol:70,souple_sol:48,plinthe:14.80,souscouche:8.80,repose_cuisine:850,
    repose_cabine:320,receveur:590,meuble:550,wc:450,robinet:180,raccord:220,modif_plomberie:350,fuite:440 };
  $('#gen-eau').addEventListener('click',()=>{ const g=GAMME[gamme],P=Peau,{rows,G,L}=mk();
    const dmFai=V('dm_faience'),dmPlaco=V('dm_placo'),plPlaco=V('pl_placo'),plPeint=V('pl_peint');
    const muPlaco=V('mu_placo'),muDoub=V('mu_doublage'),muToile=V('mu_toile'),muPeint=V('mu_peint'),muFai=V('mu_faience');
    const soSurf=V('so_surf'),soPlin=V('so_plinthe');
    G('Démolition / Dépose');
    L('Démolition de la faïence existante',dmFai,'m²',P.dm_faience); L('Dépose / démolition du placo',dmPlaco,'m²',P.dm_placo);
    if(CK('c_depcui')) L('Dépose de la cuisine équipée',1,'F',P.depose_cuisine);
    if(soltype==='parquet') L('Dépose du parquet + plinthes',soSurf,'m²',P.depose_parquet);
    if(CK('c_cabine')) L('Dépose + repose cabine / receveur',1,'F',P.depose_cabine);
    L('Protection chantier',1,'F',120);
    if(plPlaco>0||plPeint>0){ G('Plafond'); L('Dépose + repose placo plafond',plPlaco,'m²',P.placo); L('Peinture plafond (2 couches)',plPeint,'m²',P.peint); }
    if(muPlaco>0||muDoub>0||muToile>0||muPeint>0||muFai>0){ G('Murs');
      if(muPlaco>0){ L('Placo BA13 hydrofuge',muPlaco,'m²',P.placo); L('Bande + enduit',1,'F',P.enduit); }
      L('Doublage isolé (placo + isolation)',muDoub,'m²',P.doublage*g);
      L('Toile de verre murs',muToile,'m²',P.toile*g); L('Peinture murs',muPeint,'m²',P.peint); L('Faïence',muFai,'m²',P.faience*g); }
    if(soSurf>0&&soltype!=='aucun'){ G('Sols');
      if(soltype==='parquet'){ if(CK('c_souscouche')) L('Sous-couche',soSurf,'m²',P.souscouche); L('Parquet flottant',soSurf,'m²',P.parquet*g); }
      else if(soltype==='carrelage') L('Carrelage',soSurf,'m²',P.carrelage_sol*g);
      else L('Sol souple (PVC/lino)',soSurf,'m²',P.souple_sol*g); }
    L('Plinthes', soPlin,'ml',P.plinthe*g);
    if(CK('c_depcui')) { G('Cuisine'); L('Repose de la cuisine équipée',1,'F',P.repose_cuisine); }
    if(CK('c_bac')||CK('c_meuble')||CK('c_wc')||CK('c_robinet')||CK('c_plomberie')||CK('c_cabine')){ G('Sanitaire / Plomberie');
      if(CK('c_bac')){ L('Fourniture et pose receveur',1,'U',P.receveur*g); L('Raccordement plomberie receveur',1,'F',P.raccord); }
      if(CK('c_cabine')) L('Repose cabine + mitigeur',1,'U',P.repose_cabine);
      if(CK('c_meuble')) L('Fourniture et pose meuble vasque',1,'U',P.meuble*g);
      if(CK('c_wc')) L('Fourniture et pose WC',1,'U',P.wc*g);
      if(CK('c_robinet')) L('Fourniture et pose robinetterie',1,'U',P.robinet*g);
      if(CK('c_plomberie')) L('Modification / reprise réseau plomberie',1,'F',P.modif_plomberie); }
    if(CK('c_fuite')){ G('Recherche de fuite'); L('Recherche de fuite destructive',1,'F',P.fuite,0.2); }
    renderDevis(rows,'Reprise suite à un dégât des eaux');
  });

  // ===== INCENDIE =====
  const Pfeu={ deco_plaf:5,deco_mur:5,deco_sol:3.6,lessiv_porte:21,lessiv_fenetre:18,
    purge:12,dep_placo:18.5,placo:45,enduit:220,peint:22.5,elec:1800,benne:900,carton:2.9 };
  $('#gen-feu').addEventListener('click',()=>{ const P=Pfeu,{rows,G,L}=mk();
    G('Décontamination (dépollution)');
    L('Décontamination plafonds (gommage)',V('fe_decoplaf'),'m²',P.deco_plaf);
    L('Décontamination murs (gommage)',V('fe_decomur'),'m²',P.deco_mur);
    L('Décontamination sols + protection',V('fe_decosol'),'m²',P.deco_sol);
    L('Lessivage des portes',V('fe_portes'),'U',P.lessiv_porte);
    L('Lessivage des fenêtres',V('fe_fenetres'),'U',P.lessiv_fenetre);
    G('Déblais / Dépose');
    L('Purge plâtre + lattis plafond',V('fe_purge'),'m²',P.purge);
    L('Dépose placo + isolant détruits',V('fe_depplaco'),'m²',P.dep_placo);
    if(CK('fe_cuisine')) L('Dépose de la cuisine équipée',1,'F',800);
    G('Remise en état');
    if(V('fe_placoplaf')>0){ L('Repose placo plafond',V('fe_placoplaf'),'m²',P.placo); }
    if(V('fe_placomur')>0){ L('Repose placo murs',V('fe_placomur'),'m²',P.placo); L('Bande + enduit',1,'F',P.enduit); }
    L('Peinture plafonds (2 couches)',V('fe_peintplaf'),'m²',P.peint);
    L('Peinture murs (prépa + 2 couches)',V('fe_peintmur'),'m²',P.peint);
    if(CK('fe_elec')){ G('Électricité'); L('Remise aux normes de l\'installation électrique',1,'F',P.elec); }
    G('Logistique'); L('Benne + évacuation en centre agréé',1,'F',P.benne);
    renderDevis(rows,'Remise en état suite à un incendie');
  });

  // ===== TEMPÊTE =====
  const Ptemp={ tuiles:65,liteaux:25,ecran:15,echaf:900,charpente:55,gouttiere:45,faitage:40,maco:85,fenetre:550,volet:350 };
  $('#gen-tempete').addEventListener('click',()=>{ const P=Ptemp,{rows,G,L}=mk();
    const toit=V('te_toit');
    if(toit>0||CK('te_echaf')){ G('Couverture');
      if(CK('te_echaf')) L('Échafaudage / sécurisation',1,'F',P.echaf);
      L('Dépose et repose de la couverture (tuiles)',toit,'m²',P.tuiles);
      if(CK('te_liteaux')) L('Remplacement liteaux / volige',toit,'m²',P.liteaux);
      if(CK('te_ecran')) L('Pose écran sous-toiture',toit,'m²',P.ecran); }
    if(V('te_charpente')>0){ G('Charpente'); L('Réparation / renfort de charpente',V('te_charpente'),'ml',P.charpente); }
    if(V('te_gouttiere')>0||V('te_faitage')>0){ G('Zinguerie');
      L('Gouttières / chéneaux',V('te_gouttiere'),'ml',P.gouttiere); L('Faîtage',V('te_faitage'),'ml',P.faitage); }
    if(V('te_maco')>0){ G('Maçonnerie'); L('Reprise de maçonnerie',V('te_maco'),'m²',P.maco); }
    if(V('te_fenetres')>0||V('te_volets')>0){ G('Menuiseries');
      L('Fourniture et pose fenêtre',V('te_fenetres'),'U',P.fenetre); L('Fourniture et pose volet',V('te_volets'),'U',P.volet); }
    renderDevis(rows,'Réparations suite à une tempête');
  });

  function openTravaux(t,s){ $('#g2-title').textContent=t; $('#g2-sub').textContent=s; go('s2g'); }
  const Ptrav={ ouverture:1500,dalle:80,cloison:55,doublage:63,fauxplaf:55,carr:70,faience:90,parquet:55,peint:22.5,eau:350,chauffe:900,elec:2500,fen:550,porte:350,cuisine:5000 };
  $('#gen-travaux')?.addEventListener('click',()=>{ const P=Ptrav,{rows,G,L}=mk();
    G('Gros œuvre / Maçonnerie'); L('Ouverture de mur / création d\'ouverture',V('tv_ouv'),'U',P.ouverture); L('Dalle / chape béton',V('tv_dalle'),'m²',P.dalle);
    G('Plâtrerie / Isolation'); L('Cloisons placo',V('tv_cloison'),'m²',P.cloison); L('Doublage isolé',V('tv_doublage'),'m²',P.doublage); L('Faux plafond',V('tv_fauxplaf'),'m²',P.fauxplaf);
    G('Carrelage / Faïence'); L('Carrelage au sol',V('tv_carr'),'m²',P.carr); L('Faïence',V('tv_faience'),'m²',P.faience);
    G('Sols / Peinture'); L('Parquet / sol stratifié',V('tv_parquet'),'m²',P.parquet); L('Peinture (murs + plafonds)',V('tv_peint'),'m²',P.peint);
    G('Plomberie / Électricité'); L('Création / déplacement de points d\'eau',V('tv_eau'),'U',P.eau); if(CK('tv_chauffe')) L('Chauffe-eau / chaudière',1,'F',P.chauffe); if(CK('tv_elec')) L('Électricité — mise aux normes complète',1,'F',P.elec);
    G('Menuiseries'); L('Fourniture et pose fenêtre',V('tv_fen'),'U',P.fen); L('Fourniture et pose porte intérieure',V('tv_porte'),'U',P.porte); if(CK('tv_cuisine')) L('Fourniture et pose cuisine équipée',1,'F',P.cuisine);
    renderDevis(rows,'Devis de travaux ('+travauxBut+')');
  });
  function openCapture(intent){ capIntent=intent; $('#cap-title').textContent = intent==='assurance' ? 'Recevez votre devis par email — vos coordonnées' : 'Faites réaliser par Expert Travaux — vos coordonnées'; $('#capture').style.display='block'; $('#capture').scrollIntoView({behavior:'smooth'}); }
  $('#pay')?.addEventListener('click',()=>openCapture('assurance'));
  $('#do')?.addEventListener('click',()=>openCapture('travaux'));

  // Génère le devis en PDF natif (texte net, fidèle, jamais de page blanche)
  function buildDevisPdf(d){
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({unit:'mm', format:'a4'});
    const W = doc.internal.pageSize.getWidth(), H = doc.internal.pageSize.getHeight(), M = 15;
    const fmt = n => euro(n).replace(/[  ]/g,' ');
    doc.setFont('helvetica','bold'); doc.setFontSize(16); doc.setTextColor(26,24,21);
    doc.text('Expert Travaux', M, 20);
    doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(70,64,56);
    doc.text('AKHALOUF Youness', M, 26);
    doc.text('3 pradets des Fraysses - 31810 Clermont le fort', M, 31);
    doc.text('Tel : 07 81 84 41 03  -  expert.conseil.travaux@gmail.com', M, 36);
    doc.text('SIRET : 485 082 994 00032', M, 41);
    doc.text('Devis N° '+(d.num||''), W-M, 20, {align:'right'});
    doc.text('Date : '+(d.date||''), W-M, 25, {align:'right'});
    doc.text('Validité : 1 mois', W-M, 30, {align:'right'});
    doc.setDrawColor(180,137,78); doc.setLineWidth(0.5); doc.line(M, 46, W-M, 46);
    doc.setFont('helvetica','bold'); doc.setFontSize(10.5); doc.setTextColor(26,24,21);
    doc.text('DOSSIER : '+(d.dossier||''), M, 54);
    const body=(d.rows||[]).map(r=> r.grp
      ? [{content:r.grp, colSpan:5, styles:{fontStyle:'bold', fillColor:[26,24,21], textColor:[207,166,104]}}]
      : [r.d, (''+r.q).replace('.',','), r.u, fmt(r.pu), fmt(r.tot)]);
    doc.autoTable({
      startY:58, head:[['Désignation','Qté','U','P.U. HT','Total HT']], body, theme:'grid',
      styles:{font:'helvetica', fontSize:8.5, cellPadding:1.5, textColor:[40,37,32], lineColor:[225,218,206], lineWidth:0.1},
      headStyles:{fillColor:[26,24,21], textColor:[207,166,104], halign:'left'},
      columnStyles:{1:{halign:'right',cellWidth:16}, 2:{halign:'center',cellWidth:12}, 3:{halign:'right',cellWidth:26}, 4:{halign:'right',cellWidth:28}},
      margin:{left:M, right:M}
    });
    let y=doc.lastAutoTable.finalY+8;
    if(y>H-45){ doc.addPage(); y=20; }
    const lx=W-M-70, vx=W-M;
    doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(70,64,56);
    doc.text('Sous-total HT', lx, y); doc.text(fmt(d.ht), vx, y, {align:'right'}); y+=6;
    doc.text('TVA (10 %)', lx, y); doc.text(fmt(d.tva), vx, y, {align:'right'}); y+=3;
    doc.setDrawColor(26,24,21); doc.setLineWidth(0.4); doc.line(lx, y, vx, y); y+=7;
    doc.setFont('helvetica','bold'); doc.setFontSize(13); doc.setTextColor(26,24,21);
    doc.text('Total TTC', lx, y); doc.text(fmt(d.ttc), vx, y, {align:'right'}); y+=12;
    doc.setFont('helvetica','italic'); doc.setFontSize(8); doc.setTextColor(120,115,108);
    doc.text('Prix indicatifs - évacuation 1 % - TVA 10 %. Devis établi à titre indicatif.', M, y);
    try{
      const pages=doc.internal.getNumberOfPages();
      for(let p=1;p<=pages;p++){ doc.setPage(p);
        doc.saveGraphicsState(); doc.setGState(new doc.GState({opacity:0.10}));
        doc.setFont('helvetica','bold'); doc.setFontSize(72); doc.setTextColor(180,137,78);
        doc.text('SPÉCIMEN', W/2, H/2, {align:'center', angle:38});
        doc.restoreGraphicsState();
      }
    }catch(e){}
    return doc;
  }

  $('#cap-send')?.addEventListener('click',async()=>{
    const prenom=$('#cap-prenom').value.trim(), nom=$('#cap-nom').value.trim(), tel=$('#cap-tel').value.trim(), email=$('#cap-email').value.trim();
    const rappel=CK('cap-rappel');
    if(!prenom||!tel||!email){ $('#cap-done').textContent='Merci de renseigner prénom, téléphone et email.'; return; }
    if(!supabase){ $('#cap-done').textContent='Service momentanément indisponible — appelez-nous au 07 81 84 41 03.'; return; }
    const btn=$('#cap-send'); btn.disabled=true; btn.textContent='Génération du devis…';
    // Génère un PDF fidèle du devis affiché (pour l'email + le téléchargement)
    let pdfB64=null, pdfUri=null;
    try{
      if(window.jspdf && lastDevis && lastDevis.rows){
        const doc=buildDevisPdf(lastDevis);
        pdfUri=doc.output('datauristring');
        pdfB64=(pdfUri.split('base64,')[1])||null;
      }
    }catch(e){ console.error('PDF',e); }
    btn.textContent='Envoi…';
    const { error } = await supabase.from('leads').insert({
      prenom, nom, email, telephone:tel,
      type_projet: lastDevis?lastDevis.dossier:'Demande de devis',
      budget: lastDevis?('≈ '+euro(lastDevis.ttc)+' TTC'):'',
      message: (capIntent==='assurance'?'DEVIS POUR ASSURANCE':'DEMANDE DE TRAVAUX')+' — '+(lastDevis?lastDevis.dossier:'')+'\n\n'+(lastDevis?lastDevis.resume:'')+'\n\n☎ RAPPEL SOUS 24H : '+(rappel?'OUI':'non'),
      source: 'devis-'+capIntent,
      data: { intent:capIntent, devis:{dossier:lastDevis?.dossier, ht:lastDevis?.ht, ttc:lastDevis?.ttc}, rappel24h:rappel, pdf:pdfB64, pdfname:'Devis-ExpertReno.pdf' },
    });
    btn.disabled=false; btn.textContent='Envoyer →';
    if(error){ $('#cap-done').textContent='Une erreur est survenue. Réessayez ou appelez-nous.'; console.error(error); return; }
    const dl = pdfUri ? '<a class="btn" href="'+pdfUri+'" download="Devis-ExpertReno.pdf" style="display:block;text-align:center;text-decoration:none;margin-top:12px">📄 Télécharger mon devis (PDF)</a>' : '';
    $('#capture').innerHTML='<div class="lbl">✅ Merci, c\'est envoyé !</div>'+
      '<p class="note" style="text-align:left">Votre devis vient de vous être envoyé par email'+(pdfUri?' (PDF joint)':'')+'.'+(rappel?' Vous avez demandé à être recontacté(e) sous 24 h.':'')+'</p>'+
      dl+
      '<div style="display:flex;gap:10px;margin-top:14px;flex-wrap:wrap">'+
        '<a href="/services" style="flex:1;min-width:140px;text-align:center;padding:13px;border-radius:12px;border:1px solid #B4894E;color:#1A1815;text-decoration:none;font-weight:600">Découvrir nos services</a>'+
        '<a href="/" style="flex:1;min-width:140px;text-align:center;padding:13px;border-radius:12px;background:#1A1815;color:#fff;text-decoration:none;font-weight:600">Retour au site</a>'+
      '</div>';
  });
</script>
</body>
</html>
