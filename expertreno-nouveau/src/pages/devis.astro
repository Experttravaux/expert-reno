---
// ════════════════════════════════════════════════════════════════════
//  OUTIL DE DEVIS — Expert Réno / Expert Travaux
//  Génère un devis par corps détat (sinistre, pret, estimation, travaux)
//  à partir de ta grille de prix, puis capture la demande dans le CRM.
// ════════════════════════════════════════════════════════════════════
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Obtenir un devis — Expert Réno</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js" defer></script>
<style>
  :root{--onyx:#1A1815;--brass:#B4894E;--brassd:#8A6A38;--ivory:#F7F4EF;--cream:#ECE7DF;--ink:#17150F;--taupe:#6E685E}
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Inter',sans-serif;background:var(--ivory);color:var(--ink);line-height:1.5;padding:0 0 60px}
  header{border-bottom:1px solid var(--cream);background:#fff;position:sticky;top:0;z-index:5}
  .bar{max-width:720px;margin:0 auto;height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 16px}
  .logo{display:flex;align-items:center;gap:9px;font-family:'Fraunces',serif;font-weight:700;color:var(--onyx);font-size:17px}
  .logo svg{width:32px;height:32px}
  .tag{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--brassd)}
  main{max-width:720px;margin:0 auto;padding:26px 16px}
  .back{background:none;border:none;color:var(--taupe);font-size:13px;font-weight:600;cursor:pointer;margin-bottom:14px;display:none}
  h1{font-family:'Fraunces',serif;font-size:26px;color:var(--onyx);text-align:center;line-height:1.15}
  .sub{text-align:center;color:var(--taupe);margin:9px 0 22px;font-size:14.5px}
  .screen{display:none}.screen.on{display:block;animation:f .25s ease}
  @keyframes f{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .cards{display:grid;gap:12px}
  .pick{display:flex;gap:14px;align-items:flex-start;text-align:left;background:#fff;border:1.5px solid var(--cream);border-radius:16px;padding:16px 18px;cursor:pointer;transition:all .15s;width:100%}
  .pick:hover{border-color:var(--brass);transform:translateY(-1px)}
  .pem{font-size:25px;flex:none;line-height:1.1}
  .ptxt{display:flex;flex-direction:column}
  .pt{display:block;font-weight:700;font-size:16px;color:var(--ink)}
  .ps{display:block;font-size:12.5px;color:var(--taupe);margin-top:4px}
  .card{background:#fff;border:1px solid var(--cream);border-radius:16px;padding:18px;margin-bottom:12px;box-shadow:0 10px 30px -22px rgba(26,24,21,.4)}
  .lbl{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--brassd);margin:0 0 12px;display:flex;align-items:center;gap:7px}
  .line{display:flex;align-items:center;gap:12px;padding:9px 12px;border:1px solid var(--cream);border-radius:11px;margin-bottom:8px}
  .line:last-child{margin-bottom:0}
  .line label{flex:1;font-size:14px;cursor:pointer}
  .line input[type=number]{width:78px;border:1px solid var(--cream);border-radius:8px;padding:7px 10px;font-size:14px;font-family:inherit}
  .unit{font-size:12px;color:var(--taupe);width:26px}
  .sw{position:relative;width:44px;height:26px;flex:none}.sw input{opacity:0;width:0;height:0}
  .sl{position:absolute;inset:0;background:#d9d2c6;border-radius:999px;transition:.2s;cursor:pointer}
  .sl:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}
  .sw input:checked + .sl{background:var(--brass)}.sw input:checked + .sl:before{transform:translateX(18px)}
  .btn{width:100%;background:var(--onyx);color:#fff;border:none;border-radius:999px;padding:15px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit}
  .btn:hover{background:#000}
  input.f,textarea.f{width:100%;border:1px solid var(--cream);border-radius:9px;padding:11px 14px;font-size:14px;font-family:inherit;outline:none;margin-bottom:9px}
  .seg{display:flex;gap:8px;flex-wrap:wrap}
  .seg button{font-size:13px;font-weight:600;border:1px solid var(--cream);background:#fff;border-radius:999px;padding:8px 14px;cursor:pointer}
  .seg button.on{background:var(--onyx);color:var(--ivory);border-color:var(--onyx)}
  .drop{display:block;border:2px dashed var(--brass);border-radius:12px;padding:18px 14px;text-align:center;background:#FBF8F3;cursor:pointer;color:var(--brassd);font-weight:600;font-size:13.5px}
  .drop small{display:block;color:var(--taupe);font-weight:400;font-size:12px;margin-top:4px}
  .sheet{background:#fff;border:1px solid var(--cream);border-radius:12px;padding:20px;position:relative;overflow:hidden}
  .wm{position:absolute;top:46%;left:50%;transform:translate(-50%,-50%) rotate(-28deg);font-family:'Fraunces',serif;font-size:62px;font-weight:700;color:rgba(180,137,78,.13);pointer-events:none;white-space:nowrap}
  .ent{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;border-bottom:2px solid var(--onyx);padding-bottom:10px}
  .co{font-family:'Fraunces',serif;font-weight:700;font-size:16px;color:var(--onyx)}
  .sm{font-size:11px;color:var(--taupe);line-height:1.45}
  table{width:100%;border-collapse:collapse;margin-top:10px;font-size:11.5px}
  th{background:var(--onyx);color:var(--brass);text-align:left;padding:6px 7px;font-size:10px;text-transform:uppercase}
  th.r,td.r{text-align:right}
  td{padding:5px 7px;border-bottom:1px solid #f0ece4}
  .grp td{background:#faf7f2;font-weight:700;color:var(--onyx)}
  .tot{margin:12px 0 0 auto;width:250px;font-size:13px}
  .tot div{display:flex;justify-content:space-between;padding:3px 0}
  .tot .ttc{border-top:2px solid var(--onyx);margin-top:4px;padding-top:7px;font-family:'Fraunces',serif;font-weight:700;font-size:16px;color:var(--onyx)}
  .exits{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}
  @media(max-width:480px){.exits{grid-template-columns:1fr}}
  .ex{border:none;border-radius:12px;padding:14px;font-weight:700;font-size:14px;cursor:pointer;font-family:inherit}
  .ex1{background:var(--onyx);color:#fff}.ex2{background:var(--brass);color:var(--onyx)}
  .note{font-size:12px;color:var(--taupe);text-align:center;margin-top:8px}
</style>
</head>
<body>
<header><div class="bar">
  <div class="logo"><svg viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="#1A1815"/><circle cx="32" cy="32" r="23" fill="none" stroke="#B4894E" stroke-width="4.5" stroke-linecap="round" stroke-dasharray="116 30" transform="rotate(125 32 32)"/><text x="17" y="42" font-family="Georgia,serif" font-size="28" font-weight="700" fill="#B4894E">E</text><text x="31" y="44" font-family="Georgia,serif" font-size="30" font-weight="700" fill="#F7F4EF">R</text></svg>Expert Réno</div>
  <span class="tag">Obtenir un devis</span>
</div></header>

<main>
  <button class="back" id="back">← Retour</button>

  <!-- S0 -->
  <div class="screen on" id="s0">
    <h1>J'ai besoin d'un devis</h1>
    <p class="sub">Pour quoi faire ? On s'adapte à votre besoin.</p>
    <div class="cards">
      <button class="pick" data-go="sinistre"><span class="pem">🛡️</span><span class="ptxt"><span class="pt">Pour un sinistre / mon assurance</span><span class="ps">[ Dégât des eaux, incendie, tempête… un devis au juste prix ]</span></span></button>
      <button class="pick" data-go="pret"><span class="pem">🏦</span><span class="ptxt"><span class="pt">Pour un prêt travaux</span><span class="ps">[ Un devis détaillé et crédible pour votre financement ]</span></span></button>
      <button class="pick" data-go="estim"><span class="pem">📊</span><span class="ptxt"><span class="pt">Pour une estimation</span><span class="ps">[ Savoir combien coûtent vos travaux — rénovation ou neuf ]</span></span></button>
      <button class="pick" data-go="travaux"><span class="pem">🔨</span><span class="ptxt"><span class="pt">Pour faire réaliser mes travaux</span><span class="ps">[ Passer à l'action avec Expert Travaux ]</span></span></button>
    </div>
  </div>

  <!-- S1 -->
  <div class="screen" id="s1">
    <h1>Quel type de sinistre ?</h1>
    <p class="sub">On calcule sur la base de prix acceptée par les assurances.</p>
    <div class="cards">
      <button class="pick" data-go="eau"><span class="pem">💧</span><span class="ptxt"><span class="pt">Dégât des eaux</span><span class="ps">[ Fuite, infiltration, dégât venant du voisin du dessus… ]</span></span></button>
      <button class="pick" data-go="feu"><span class="pem">🔥</span><span class="ptxt"><span class="pt">Incendie / fumées</span><span class="ps">[ Décontamination, déblais, plâtrerie, électricité… ]</span></span></button>
      <button class="pick" data-go="tempete"><span class="pem">🌪️</span><span class="ptxt"><span class="pt">Tempête</span><span class="ps">[ Couverture, charpente, zinguerie, maçonnerie… ]</span></span></button>
    </div>
  </div>

  <!-- S2 : DÉGÂT DES EAUX -->
  <div class="screen" id="s2">
    <h1>Dégât des eaux</h1>
    <p class="sub">Pièce par pièce — ou décrivez à la voix.</p>
    <div class="card" style="border-color:var(--brass)">
      <div class="lbl">🎤 Pressé ? Décrivez vos travaux à la voix</div>
      <p style="font-size:13px;color:var(--taupe);margin-bottom:10px">Dites : <b>la pièce</b>, les <b>surfaces abîmées</b> (sol, murs, plafond en m²), <b>ce qui est cassé</b>, le <b>niveau de finition</b>.</p>
      <button class="btn" id="voice" style="background:var(--brass);color:var(--onyx)">🎙️ Enregistrer ma description (max 2 min)</button>
      <p class="note" id="voicenote" style="text-align:left"></p>
    </div>
    <div class="card"><div class="lbl">⭐ Gamme des équipements</div><div class="seg gamme"><button class="on" data-g="essentiel">💧 Essentiel</button><button data-g="confort">⭐ Confort</button><button data-g="premium">💎 Premium</button></div></div>
    <div class="card"><div class="lbl">🧨 Démolition / dépose</div>
      <div class="line"><label>Démolir la faïence existante</label><input type="number" id="dm_faience" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Démolir / déposer le placo</label><input type="number" id="dm_placo" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_depcui"><span class="sl"></span></span><label for="c_depcui">Dépose de la cuisine équipée</label></div>
    </div>
    <div class="card"><div class="lbl">🔝 Plafond</div>
      <div class="line"><label>Placo plafond (dépose + repose)</label><input type="number" id="pl_placo" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Peinture plafond</label><input type="number" id="pl_peint" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">🧱 Murs</div>
      <div class="line"><label>Placo / BA13 hydro à reprendre</label><input type="number" id="mu_placo" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Doublage isolé (placo + isolation)</label><input type="number" id="mu_doublage" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Toile de verre murs</label><input type="number" id="mu_toile" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Peinture murs</label><input type="number" id="mu_peint" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Faïence</label><input type="number" id="mu_faience" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">🪵 Sols</div>
      <div class="seg soltype" style="margin-bottom:10px"><button class="on" data-s="aucun">Aucun</button><button data-s="parquet">Parquet</button><button data-s="carrelage">Carrelage</button><button data-s="souple">Sol souple</button></div>
      <div class="line"><label>Surface de sol</label><input type="number" id="so_surf" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Plinthes</label><input type="number" id="so_plinthe" value="0" min="0"><span class="unit">ml</span></div>
    </div>
    <div class="card"><div class="lbl">🚿 Sanitaire / plomberie</div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_cabine"><span class="sl"></span></span><label for="c_cabine">Dépose + repose cabine / receveur</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_bac"><span class="sl"></span></span><label for="c_bac">Fourniture + pose receveur</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_meuble"><span class="sl"></span></span><label for="c_meuble">Meuble vasque</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_wc"><span class="sl"></span></span><label for="c_wc">WC</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_robinet"><span class="sl"></span></span><label for="c_robinet">Robinetterie / mitigeur</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_plomberie"><span class="sl"></span></span><label for="c_plomberie">Modification / reprise du réseau de plomberie</label></div>
    </div>
    <div class="card"><div class="lbl">🔧 Divers</div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_fuite"><span class="sl"></span></span><label for="c_fuite">Recherche de fuite destructive</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="c_souscouche" checked><span class="sl"></span></span><label for="c_souscouche">Sous-couche (si parquet)</label></div>
    </div>
    <div class="card"><div class="lbl">📎 Plan / tableau de dommages / photos</div><label class="drop">Déposez votre plan, tableau de dommages ou photos<small>l'IA le lira pour ajuster le devis</small><input type="file" hidden multiple></label></div>
    <button class="btn" id="gen-eau">Générer mon devis →</button>
  </div>

  <!-- S2E : INCENDIE -->
  <div class="screen" id="s2e">
    <h1>Incendie / fumées</h1>
    <p class="sub">Décontamination, déblais puis remise en état (base MAIF).</p>
    <div class="card"><div class="lbl">🧼 Décontamination (dépollution suies)</div>
      <div class="line"><label>Plafonds à décontaminer</label><input type="number" id="fe_decoplaf" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Murs à décontaminer</label><input type="number" id="fe_decomur" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Sols à décontaminer</label><input type="number" id="fe_decosol" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Portes à lessiver</label><input type="number" id="fe_portes" value="0" min="0"><span class="unit">u</span></div>
      <div class="line"><label>Fenêtres à lessiver</label><input type="number" id="fe_fenetres" value="0" min="0"><span class="unit">u</span></div>
    </div>
    <div class="card"><div class="lbl">🧨 Déblais / dépose</div>
      <div class="line"><label>Purge plâtre + lattis plafond</label><input type="number" id="fe_purge" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Dépose placo + isolant détruits</label><input type="number" id="fe_depplaco" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><span class="sw"><input type="checkbox" id="fe_cuisine"><span class="sl"></span></span><label for="fe_cuisine">Dépose cuisine équipée</label></div>
    </div>
    <div class="card"><div class="lbl">🧱 Remise en état</div>
      <div class="line"><label>Repose placo plafond</label><input type="number" id="fe_placoplaf" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Repose placo murs</label><input type="number" id="fe_placomur" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Peinture plafonds</label><input type="number" id="fe_peintplaf" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Peinture murs</label><input type="number" id="fe_peintmur" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">⚡ Électricité</div>
      <div class="line"><span class="sw"><input type="checkbox" id="fe_elec"><span class="sl"></span></span><label for="fe_elec">Remise aux normes électrique (après incendie)</label></div>
    </div>
    <div class="card"><div class="lbl">📎 Plan / tableau de dommages / photos</div><label class="drop">Déposez votre dossier<small>l'IA le lira pour ajuster le devis</small><input type="file" hidden multiple></label></div>
    <button class="btn" id="gen-feu">Générer mon devis →</button>
  </div>

  <!-- S2T : TEMPÊTE -->
  <div class="screen" id="s2t">
    <h1>Tempête</h1>
    <p class="sub">Toiture, charpente, structure (prix assurance).</p>
    <div class="card"><div class="lbl">🏠 Couverture (toiture)</div>
      <div class="line"><label>Surface de toiture à reprendre</label><input type="number" id="te_toit" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><span class="sw"><input type="checkbox" id="te_liteaux" checked><span class="sl"></span></span><label for="te_liteaux">Remplacement liteaux / volige</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="te_ecran" checked><span class="sl"></span></span><label for="te_ecran">Écran sous-toiture</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="te_echaf" checked><span class="sl"></span></span><label for="te_echaf">Échafaudage / sécurité</label></div>
    </div>
    <div class="card"><div class="lbl">🪚 Charpente</div>
      <div class="line"><label>Réparation / renfort charpente</label><input type="number" id="te_charpente" value="0" min="0"><span class="unit">ml</span></div>
    </div>
    <div class="card"><div class="lbl">🌧️ Zinguerie</div>
      <div class="line"><label>Gouttières / chéneaux</label><input type="number" id="te_gouttiere" value="0" min="0"><span class="unit">ml</span></div>
      <div class="line"><label>Faîtage</label><input type="number" id="te_faitage" value="0" min="0"><span class="unit">ml</span></div>
    </div>
    <div class="card"><div class="lbl">🧱 Maçonnerie</div>
      <div class="line"><label>Reprise de maçonnerie (façade, mur…)</label><input type="number" id="te_maco" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">🪟 Menuiseries</div>
      <div class="line"><label>Fenêtres à remplacer</label><input type="number" id="te_fenetres" value="0" min="0"><span class="unit">u</span></div>
      <div class="line"><label>Volets à remplacer</label><input type="number" id="te_volets" value="0" min="0"><span class="unit">u</span></div>
    </div>
    <div class="card"><div class="lbl">📎 Plan / photos des dégâts</div><label class="drop">Déposez vos photos / constat<small>l'IA le lira pour ajuster le devis</small><input type="file" hidden multiple></label></div>
    <button class="btn" id="gen-tempete">Générer mon devis →</button>
  </div>

  <!-- S2G : TRAVAUX / PRÊT / ESTIMATION (par lots) -->
  <div class="screen" id="s2g">
    <h1 id="g2-title">Votre projet de travaux</h1>
    <p class="sub" id="g2-sub"></p>
    <div class="card"><div class="lbl">🏗️ Nature du projet</div>
      <div class="seg nature" style="margin-bottom:10px"><button class="on" data-n="reno">Rénovation complète</button><button data-n="piece">Une / des pièces</button><button data-n="neuf">Construction neuve</button></div>
      <div class="line"><label>Surface concernée</label><input type="number" id="tv_surf" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">🧱 Gros œuvre / maçonnerie</div>
      <div class="line"><label>Ouverture de mur / création d'ouverture</label><input type="number" id="tv_ouv" value="0" min="0"><span class="unit">u</span></div>
      <div class="line"><label>Dalle / chape béton</label><input type="number" id="tv_dalle" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">🪵 Plâtrerie / isolation</div>
      <div class="line"><label>Cloisons placo</label><input type="number" id="tv_cloison" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Doublage isolé (murs)</label><input type="number" id="tv_doublage" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Faux plafond</label><input type="number" id="tv_fauxplaf" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">🚿 Carrelage / faïence</div>
      <div class="line"><label>Carrelage au sol</label><input type="number" id="tv_carr" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Faïence</label><input type="number" id="tv_faience" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">🪵 Parquet / peinture</div>
      <div class="line"><label>Parquet / sol stratifié</label><input type="number" id="tv_parquet" value="0" min="0"><span class="unit">m²</span></div>
      <div class="line"><label>Peinture (murs + plafonds)</label><input type="number" id="tv_peint" value="0" min="0"><span class="unit">m²</span></div>
    </div>
    <div class="card"><div class="lbl">🚰 Plomberie / ⚡ électricité</div>
      <div class="line"><label>Points d'eau à créer / déplacer</label><input type="number" id="tv_eau" value="0" min="0"><span class="unit">u</span></div>
      <div class="line"><span class="sw"><input type="checkbox" id="tv_chauffe"><span class="sl"></span></span><label for="tv_chauffe">Chauffe-eau / chaudière</label></div>
      <div class="line"><span class="sw"><input type="checkbox" id="tv_elec"><span class="sl"></span></span><label for="tv_elec">Électricité — mise aux normes complète</label></div>
    </div>
    <div class="card"><div class="lbl">🪟 Menuiseries / cuisine</div>
      <div class="line"><label>Fenêtres</label><input type="number" id="tv_fen" value="0" min="0"><span class="unit">u</span></div>
      <div class="line"><label>Portes intérieures</label><input type="number" id="tv_porte" value="0" min="0"><span class="unit">u</span></div>
      <div class="line"><span class="sw"><input type="checkbox" id="tv_cuisine"><span class="sl"></span></span><label for="tv_cuisine">Cuisine équipée</label></div>
