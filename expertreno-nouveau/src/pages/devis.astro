        <table><thead><tr><th>Désignation</th><th class="r">Qté</th><th>U</th><th class="r">P.U. HT</th><th class="r">Total HT</th></tr></thead><tbody id="rows"></tbody></table>
        <div class="tot"><div><span>Sous-total HT</span><span id="t_ht"></span></div><div><span>TVA</span><span id="t_tva"></span></div><div class="ttc"><span>Total TTC</span><span id="t_ttc"></span></div></div>
