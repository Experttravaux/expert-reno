  </div>

  <!-- S3 devis -->
  <div class="screen" id="s3">
    <div class="card">
      <div class="sheet">
        <div class="wm">SPÉCIMEN</div>
        <div class="ent">
          <div><div class="co">Expert Travaux</div><div class="sm"><b>AKHALOUF Youness</b><br>3 pradets des Fraysses — 31810 Clermont le fort<br>Tél : 07 81 84 41 03 · expert.conseil.travaux@gmail.com<br>SIRET : 485 082 994 00032</div></div>
          <div class="sm" style="text-align:right">Devis N° <b id="dnum"></b><br>Date : <span id="ddate"></span><br>Validité : 1 mois</div>
        </div>
