---
import { marques } from '../data/site';

interface Props {
  titre: string;
  resume: string;
  marque: 'reno' | 'travaux';
  lien: string;
  vedette?: boolean;
}
const { titre, resume, marque, lien, vedette = false } = Astro.props;
const nomMarque = marques[marque].nom;
---

<a
  href={lien}
  class:list={[
    'group flex flex-col rounded-2xl border border-brume bg-white p-7 shadow-card transition-transform hover:-translate-y-1',
    vedette && 'sm:col-span-2',
  ]}
>
  <span
    class:list={[
      'mb-4 inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold',
      marque === 'travaux' ? 'bg-ocre/15 text-ocre-dark' : 'bg-foret/10 text-foret',
    ]}
  >
    {nomMarque}
  </span>
  <h3 class="font-serif text-xl font-bold text-foret">{titre}</h3>
  <p class="mt-2 flex-1 text-sm text-ardoise">{resume}</p>
  <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-ocre-dark">
    En savoir plus
    <span class="transition-transform group-hover:translate-x-1">→</span>
  </span>
</a>
