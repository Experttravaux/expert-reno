---
// Galerie photo d'un projet. Les images proviennent du champ "galerie"
// défini dans le fichier Markdown du projet (src/content/projets/*.md).
interface ImageItem {
  src: string;
  alt: string;
}
interface Props {
  images: ImageItem[];
}
const { images } = Astro.props;
---

{
  images.length > 0 && (
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {images.map((img) => (
        <figure class="overflow-hidden rounded-xl border border-brume bg-brume">
          {/* 📷 Remplacez ces images par vos vraies photos de chantier dans /public/images/projets/ */}
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            class="aspect-[4/3] h-full w-full object-cover"
          />
        </figure>
      ))}
    </div>
  )
}
