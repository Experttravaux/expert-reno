---
import { site, contact, reseaux, navigation, marques } from '../data/site';
const annee = new Date().getFullYear();
---

<footer class="border-t border-brume bg-sable text-encre">
  <!-- Bandeau CTA devis (présent sur toutes les pages) -->
  <div class="bg-foret">
    <div class="mx-auto flex max-w-content flex-col items-center justify-between gap-5 px-5 py-9 text-center sm:flex-row sm:text-left">
      <div>
        <p class="font-serif text-xl font-bold text-white sm:text-2xl">Un projet ou un sinistre ? Obtenez votre devis en ligne.</p>
        <p class="mt-1 text-sm text-white/70">Gratuit, immédiat, sans engagement · particuliers, assurances &amp; syndics.</p>
      </div>
      <a href="/devis" class="inline-flex flex-none items-center justify-center rounded-full bg-ocre px-8 py-4 font-bold text-foret shadow-card transition-colors hover:bg-ocre-light">
        📋 Obtenir un devis
      </a>
    </div>
  </div>
  <div class="mx-auto max-w-content px-5 py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Marques -->
      <div>
        <p class="font-serif text-xl font-bold text-foret">{marques.reno.nom}</p>
        <p class="text-sm text-ardoise">{marques.reno.role}</p>
        <p class="mt-3 font-serif text-xl font-bold text-ocre-dark">{marques.travaux.nom}</p>
        <p class="text-sm text-ardoise">{marques.travaux.role}</p>
        <p class="mt-4 text-sm text-ardoise">{site.experience} d’expérience tous corps d’état.</p>
      </div>

      <!-- Navigation -->
      <nav aria-label="Liens de pied de page">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-foret">Navigation</p>
        <ul class="space-y-2">
          {navigation.map((item) => (
            <li>
              <a href={item.lien} class="text-sm text-ardoise hover:text-ocre-dark">{item.libelle}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-foret">Contact</p>
        <ul class="space-y-2 text-sm text-ardoise">
          <li><a href={`tel:${contact.telephone}`} class="hover:text-ocre-dark">{contact.telephoneAffiche}</a></li>
          <li><a href={`mailto:${contact.email}`} class="hover:text-ocre-dark">{contact.email}</a></li>
          <li><a href={reseaux.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-dark">WhatsApp</a></li>
        </ul>
        <p class="mt-4 text-sm text-ardoise">{site.zones.join(' · ')}</p>
      </div>

      <!-- Réseaux sociaux -->
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-foret">Suivez-nous</p>
        <ul class="space-y-2 text-sm text-ardoise">
          <li><a href={reseaux.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-dark">Instagram</a></li>
          <li><a href={reseaux.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-dark">LinkedIn</a></li>
          <li><a href={reseaux.twitter} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-dark">X (Twitter)</a></li>
          <li><a href={reseaux.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-dark">WhatsApp</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-brume pt-6 text-xs text-ardoise sm:flex-row sm:items-center sm:justify-between">
      <p>© {annee} {site.nom} — {marques.travaux.nom}. Tous droits réservés.</p>
      <p>Assistance à maîtrise d’ouvrage & entreprise générale de bâtiment — {contact.ville} et toute la France.</p>
    </div>
  </div>
</footer>
