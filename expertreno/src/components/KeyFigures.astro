---
// Chiffres-clés du secteur, présentés comme des problèmes que nous résolvons.
// Les données proviennent de src/data/site.ts (chiffresCles).
import { chiffresCles } from '../data/site';
---

<section class="bg-sable">
  <div class="mx-auto max-w-content px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-ocre-dark">Pourquoi se faire accompagner</p>
      <h2 class="mt-3 font-serif text-3xl font-bold text-foret sm:text-4xl">
        La rénovation tourne mal trop souvent. Pas avec nous.
      </h2>
      <p class="mt-4 text-ardoise">
        Voici la réalité d’un chantier mal piloté — et ce que nous mettons en place pour vous l’éviter.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        chiffresCles.map((c) => (
          <div class="rounded-2xl border border-brume bg-white p-6 shadow-card">
            <p class="font-serif text-4xl font-bold text-foret">{c.valeur}</p>
            <p class="mt-2 text-sm font-medium text-encre">{c.label}</p>
            <p class="mt-4 border-t border-brume pt-4 text-sm text-ardoise">
              <span class="font-semibold text-ocre-dark">Notre réponse : </span>
              {c.solution}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
