---
interface Props {
  titre: string;
  resume: string;
  budget: string;
  ameublement?: string;
  delaiTravaux: string;
  couverture?: string;
  lien: string;
}
const { titre, resume, budget, ameublement, delaiTravaux, couverture, lien } = Astro.props;
---

<a
  href={lien}
  class="group flex flex-col overflow-hidden rounded-2xl border border-brume bg-white shadow-card transition-transform hover:-translate-y-1"
>
  <!-- 📷 Image de couverture (placeholder si la photo n'existe pas encore) -->
  <div class="aspect-[4/3] overflow-hidden bg-brume">
    {
      couverture ? (
        <img
          src={couverture}
          alt={`Réalisation : ${titre}`}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-sm text-ardoise">Photo à insérer</div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-serif text-lg font-bold text-foret">{titre}</h3>
    <p class="mt-2 flex-1 text-sm text-ardoise">{resume}</p>
    <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 border-t border-brume pt-4 text-sm">
      <div>
        <dt class="text-xs uppercase tracking-wide text-ardoise">Budget</dt>
        <dd class="font-semibold text-encre">
          {budget}{ameublement && <span class="font-normal text-ardoise"> + {ameublement}</span>}
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-ardoise">Délai</dt>
        <dd class="font-semibold text-encre">{delaiTravaux}</dd>
      </div>
    </dl>
  </div>
</a>
