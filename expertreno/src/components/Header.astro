---
import { navigation } from '../data/site';
import BookingButton from './BookingButton.astro';

// Détermine le lien actif pour le surligner dans le menu.
const path = Astro.url.pathname;
const isActive = (lien: string) =>
  lien === '/' ? path === '/' : path.startsWith(lien);
---

<header class="sticky top-0 z-50 border-b border-brume bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-20 max-w-content items-center gap-4 px-5">
    <!-- Logo : monogramme ER + les deux marques (Expert Réno + Expert Travaux) -->
    <!-- 💡 Pour utiliser VOTRE logo : remplacez le <svg> ci-dessous par
         <img src="/logo.svg" alt="Expert Réno" class="h-11 w-auto" /> après avoir
         déposé votre fichier dans public/ (logo.svg ou logo.png). -->
    <a href="/" class="flex items-center gap-3" aria-label="Expert Réno — accueil">
      <svg viewBox="0 0 64 64" class="h-11 w-11 shrink-0" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="#EAF0E7" />
        <circle cx="32" cy="32" r="23" fill="none" stroke="#2B2B2B" stroke-width="4.5"
                stroke-linecap="round" stroke-dasharray="116 30" transform="rotate(125 32 32)" />
        <text x="17" y="42" font-family="Georgia, serif" font-size="28" font-weight="700" fill="#5DA86A">E</text>
        <text x="31" y="44" font-family="Georgia, serif" font-size="30" font-weight="700" fill="#163D2A">R</text>
      </svg>
      <span class="flex flex-col leading-tight">
        <span class="font-serif text-xl font-bold text-foret">Expert Réno</span>
        <span class="text-[11px] font-semibold uppercase tracking-wide text-ocre-dark">
          + Expert Travaux · tous corps d’état
        </span>
      </span>
    </a>

    <!-- Navigation bureau -->
    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
      {
        navigation.map((item) => (
          <a
            href={item.lien}
            aria-current={isActive(item.lien) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition-colors',
              isActive(item.lien)
                ? 'bg-brume text-foret'
                : 'text-ardoise hover:text-foret',
            ]}
          >
            {item.libelle}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <BookingButton small />
    </div>

    <!-- Bouton menu mobile -->
    <button
      id="burger"
      class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded-lg text-foret lg:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Menu mobile (masqué par défaut) -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-brume bg-white px-5 py-4 lg:hidden"
    aria-label="Navigation mobile"
  >
    <ul class="flex flex-col gap-1">
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.lien}
              aria-current={isActive(item.lien) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-4 py-3 text-base font-medium',
                isActive(item.lien) ? 'bg-brume text-foret' : 'text-ardoise',
              ]}
            >
              {item.libelle}
            </a>
          </li>
        ))
      }
      <li class="mt-2">
        <BookingButton label="Réserver un créneau" />
      </li>
    </ul>
  </nav>
</header>

<script>
  // Ouverture / fermeture du menu mobile
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    burger.setAttribute('aria-expanded', String(!isHidden));
    burger.setAttribute('aria-label', isHidden ? 'Ouvrir le menu' : 'Fermer le menu');
  });
</script>
