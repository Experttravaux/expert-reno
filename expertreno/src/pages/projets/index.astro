---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BookingButton from '../../components/BookingButton.astro';
import { getCollection } from 'astro:content';

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);

const title = 'Nos réalisations de rénovation à Toulouse | Expert Réno & Expert Travaux';
const description =
  'Découvrez nos projets de rénovation à Toulouse et en France : duplex, colocations, immeuble, studio. Budgets, délais et travaux réalisés en toute transparence.';
---

<BaseLayout title={title} description={description}>
  <PageHeader
    surtitre="Nos projets"
    titre="Des réalisations concrètes et chiffrées"
    sousTitre="Chaque projet est présenté en toute transparence : travaux réalisés, budget et délais. Les photos seront prochainement remplacées par nos chantiers réels."
  />

  <section class="bg-white">
    <div class="mx-auto max-w-content px-5 py-16">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          projets.map((p) => (
            <ProjectCard
              titre={p.data.titre}
              resume={p.data.resume}
              budget={p.data.budget}
              ameublement={p.data.ameublement}
              delaiTravaux={p.data.delaiTravaux}
              couverture={p.data.couverture}
              lien={`/projets/${p.slug}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-sable">
    <div class="mx-auto max-w-content px-5 py-14 text-center">
      <h2 class="font-serif text-2xl font-bold text-foret sm:text-3xl">Votre projet sera le prochain</h2>
      <p class="mx-auto mt-3 max-w-xl text-ardoise">Discutons de votre rénovation et de son budget.</p>
      <div class="mt-7 flex justify-center"><BookingButton label="Réserver un créneau" /></div>
    </div>
  </section>
</BaseLayout>
