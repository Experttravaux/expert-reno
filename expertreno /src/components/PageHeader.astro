---
// En-tête de page interne : titre + sous-titre, sur fond clair.
interface Props {
  surtitre?: string;
  titre: string;
  sousTitre?: string;
}
const { surtitre, titre, sousTitre } = Astro.props;
---

<section class="border-b border-brume bg-sable">
  <div class="mx-auto max-w-content px-5 py-16 sm:py-20">
    {surtitre && <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-ocre-dark">{surtitre}</p>}
    <h1 class="font-serif text-3xl font-bold leading-tight text-foret sm:text-4xl md:text-5xl">{titre}</h1>
    {sousTitre && <p class="mt-4 max-w-2xl text-lg text-ardoise">{sousTitre}</p>}
  </div>
</section>
