---
// Script d'analytics (Google Analytics 4) injecté UNIQUEMENT si la variable
// d'environnement PUBLIC_GA_ID est renseignée. Laisser vide = aucun script,
// aucun cookie. Voir .env.example.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{
  gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )
}
