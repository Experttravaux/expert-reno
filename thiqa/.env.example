# ---------------------------------------------------------------------------
# Thiqa — variables d'environnement. Ne jamais committer de vraies valeurs :
# Cloudflare Pages (front) / Supabase secrets (Edge Functions) / GitHub (CI).
# ---------------------------------------------------------------------------

# Phase 0 — Supabase (valeurs locales affichées par `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Phase 0 — CI GitHub (Settings → Secrets → environment "production")
# SUPABASE_ACCESS_TOKEN=   SUPABASE_PROJECT_REF=   SUPABASE_DB_PASSWORD=   SUPABASE_DB_URL=

# Phase 1 — Auth Google (clients)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Phase 1 — Paiement
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Phase 1 — Notifications
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Phase 1 — Anti-bot & monitoring
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Phase 3 — IA (appels côté serveur uniquement)
ANTHROPIC_API_KEY=

# Phase 3/4 — Smart BNB (simulateur de rentabilité, API partenaire)
SMARTBNB_API_URL=
SMARTBNB_API_KEY=
